# Neon Postgres — pooled connection (pgbouncer), used at runtime by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dentixa?sslmode=require&pgbouncer=true"
# Neon Postgres — direct/unpooled connection, used only by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dentixa?sslmode=require"

JWT_ACCESS_SECRET="generate-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Exact deployed frontend origin, no trailing slash (CORS + cross-site cookie)
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV="development"
CLINIC_TIMEZONE="Europe/Tirane"

# Nodemailer SMTP — works with Gmail app password, Resend, SendGrid SMTP relay, etc.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dentixa <no-reply@dentixa.com>"

# Twilio SMS — optional. If any of these are missing, SMS sending is a no-op (logged only).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
