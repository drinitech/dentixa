generator client {
  provider = "prisma-client-js"
}

// Plain TCP connection (no Neon HTTP adapter) — the backend is a long-running
// Express process, not a serverless function, so it can hold a pooled
// connection and use real interactive transactions / row locks.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DONE
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationEventType {
  APPOINTMENT_CREATED
  APPOINTMENT_APPROVED
  APPOINTMENT_REJECTED
  REMINDER
}

enum RecallStatus {
  PENDING
  NOTIFIED
  BOOKED
  DISMISSED
}

enum TenantPlan {
  FREE
  PRO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  RECEPTIONIST
  DOCTOR
  PATIENT
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

// A SaaS customer (a dental practice/business) — distinct from Location,
// which is a physical address a practice's doctors work out of. Not yet
// referenced by any tenant-scoped table; that lands once every such table
// gets a tenantId column and is backfilled into a demo tenant.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  timezone  String       @default("UTC")
  plan      TenantPlan   @default(FREE)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships        Membership[]
  locations          Location[]
  services           ClinicService[]
  doctorSchedules    DoctorSchedule[]
  scheduleExceptions ScheduleException[]
  holidays           ClinicHoliday[]
  waitlistEntries    Waitlist[]
  appointments       Appointment[]
  recallReminders    RecallReminder[]
  reviews            Review[]
}

// A user's role within one tenant. A User is global (one account can work
// across multiple clinics); role is read from here, never from User.role —
// User.role is legacy and still what auth actually checks until tenant
// resolution (Milestone 2) replaces it.
model Membership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  phone        String?
  // Doctor-only, self-set (e.g. "Orthodontist") — null/ignored for other roles.
  specialty    String?
  // Doctor-only: which clinic location they work at. Nullable at the DB
  // level (existing non-doctor rows never set it) but required by app-layer
  // validation whenever a new doctor account is created.
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  // Stored as a data: URI (small, resized client-side before upload) rather
  // than a filesystem path — Render's disk isn't persisted across deploys.
  avatarUrl    String?  @db.Text
  isActive     Boolean  @default(true)
  // Bumped on ban / password reset so previously issued refresh tokens
  // are invalidated immediately without a server-side token blacklist table.
  tokenVersion Int      @default(0)
  // Forgot-password flow: only a hash of the emailed token is stored (never
  // the raw token), mirroring how a password itself is never stored in the
  // clear. Null when no reset is pending.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorSchedules         DoctorSchedule[]          @relation("DoctorSchedules")
  scheduleExceptions      ScheduleException[]       @relation("DoctorScheduleExceptions")
  appointmentsAsPatient   Appointment[]             @relation("PatientAppointments")
  appointmentsAsDoctor    Appointment[]             @relation("DoctorAppointments")
  notificationPreferences NotificationPreference[]
  reviewsWritten          Review[]                  @relation("PatientReviews")
  reviewsReceived         Review[]                  @relation("DoctorReviews")
  // Doctor-only. Empty means "offers every active service" (backward
  // compatible default) — assigning any service switches that doctor to an
  // opt-in allowlist.
  offeredServices         ClinicService[]           @relation("DoctorServices")
  waitlistAsPatient       Waitlist[]                @relation("PatientWaitlist")
  waitlistAsDoctor        Waitlist[]                @relation("DoctorWaitlist")
  memberships             Membership[]
  recallsAsPatient        RecallReminder[]          @relation("PatientRecalls")
  recallsAsDoctor         RecallReminder[]          @relation("DoctorRecalls")

  @@index([role])
  @@index([locationId])
}

// A clinic location. Doctors belong to exactly one; the service catalog
// (ClinicService) stays shared across all locations rather than per-location —
// confirmed with the user that price/duration doesn't vary by location.
model Location {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors  User[]
  holidays ClinicHoliday[]

  @@index([tenantId])
}

model ClinicService {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  // Months after a DONE appointment for this service before a recall
  // reminder is due (e.g. 6 for a 6-monthly cleaning). Null means this
  // service never generates a recall.
  recallIntervalMonths Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments      Appointment[]
  offeredByDoctors  User[]       @relation("DoctorServices")
  waitlistEntries   Waitlist[]
  recallReminders   RecallReminder[]

  @@index([tenantId])
}

model DoctorSchedule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorSchedules", fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "09:00" 24h
  endTime   String // "17:00" 24h
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tenantId is part of the unique key (not just doctorId) because one User
  // can be a DOCTOR via Membership in more than one tenant — the same
  // person's schedule at two unrelated clinics must not collide.
  @@unique([tenantId, doctorId, dayOfWeek, startTime, endTime])
  @@index([tenantId, doctorId])
}

// A specific full-day date the doctor is unavailable (holiday/time off),
// layered on top of the recurring weekly DoctorSchedule. getFreeSlots treats
// an excepted date as having zero free slots regardless of the day-of-week
// windows that would otherwise apply.
model ScheduleException {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorScheduleExceptions", fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, doctorId, date])
  @@index([tenantId, doctorId])
}

// A closure — either location-wide (locationId set, unlike ScheduleException
// which is per-doctor) or company-wide across every location (locationId null,
// e.g. a national holiday). getFreeSlots treats a matching holiday as zero
// slots for every doctor it applies to. Admin-managed.
model ClinicHoliday {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  reason     String?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, locationId, date])
  @@index([tenantId, locationId])
}

// A patient asking to be emailed if a slot opens up for a doctor+service+date
// that currently has none. Cleared (deleted) once notified — a one-shot ping,
// not a standing subscription, since slots fill fast.
model Waitlist {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   User     @relation("PatientWaitlist", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorWaitlist", fields: [doctorId], references: [id], onDelete: Cascade)
  serviceId String
  service   ClinicService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([tenantId, patientId, doctorId, serviceId, date])
  @@index([tenantId, doctorId, date])
}

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  serviceId String?
  service   ClinicService? @relation(fields: [serviceId], references: [id])

  date            DateTime          @db.Date
  time            String // "14:30" 24h — paired with date+doctorId for slot identity
  durationMinutes Int
  status          AppointmentStatus @default(PENDING)
  reason          String?
  rejectionReason String?

  // Set once the 24h-before reminder has been sent, so the hourly sweep
  // never sends the same reminder twice for one appointment.
  reminderSentAt DateTime?

  // Doctor-authored clinical notes about the visit (diagnosis, treatment
  // given). Only the treating doctor can write it; the patient can read it.
  visitNotes String? @db.Text

  review Review?
  recallReminder RecallReminder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tenantId leads every index/constraint here, not just for query performance:
  // once one User can be a DOCTOR via Membership in multiple tenants, a bare
  // (doctorId, date, time) uniqueness check would wrongly block that person
  // from holding appointments at two unrelated clinics in the same slot.
  @@index([tenantId, doctorId, date])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

// Created when a DONE appointment's service has a recallIntervalMonths set —
// a one-shot "you're due for a checkup again" ping, closed out either by the
// daily sweep notifying the patient or by the patient booking again (whichever
// happens, see recall.service.ts / appointment.service.ts).
model RecallReminder {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   User         @relation("PatientRecalls", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User         @relation("DoctorRecalls", fields: [doctorId], references: [id], onDelete: Cascade)
  serviceId String
  service   ClinicService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  sourceAppointmentId String      @unique
  sourceAppointment   Appointment @relation(fields: [sourceAppointmentId], references: [id], onDelete: Cascade)

  dueDate    DateTime     @db.Date
  notifiedAt DateTime?
  status     RecallStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([tenantId, patientId, status])
  @@index([tenantId, dueDate, status])
}

// One review per appointment, only left once the visit is DONE. Denormalizes
// patientId/doctorId (derivable from appointment) so doctor-average and
// patient-history queries don't need a join through Appointment.
model Review {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User     @relation("DoctorReviews", fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([tenantId, doctorId])
}

model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  eventType NotificationEventType
  enabled   Boolean               @default(true)

  @@unique([userId, channel, eventType])
}
